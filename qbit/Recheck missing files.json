{
  "_slug": "recheck-missing-files",
  "name": "Recheck: missing files",
  "trackerPattern": "*",
  "trackerDomains": [
    "*"
  ],
  "conditions": {
    "schemaVersion": "1",
    "recheck": {
      "enabled": true,
      "condition": {
        "operator": "AND",
        "conditions": [
          {
            "field": "STATE",
            "operator": "EQUAL",
            "value": "missingFiles"
          },
          {
            "field": "LAST_ACTIVITY_AGE",
            "operator": "LESS_THAN",
            "value": "86400"
          }
        ]
      }
    }
  },
  "intervalSeconds": 3600,
  "sortOrder": 8
}
